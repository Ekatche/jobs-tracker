# ==============================================================================
# Job Tracker - Variables d'environnement (Exemple / Modèle)
# ==============================================================================
# Ce fichier sert de modèle. Copiez-le vers .env et renseignez vos valeurs réelles :
#   cp .env.example .env
#
# IMPORTANT : Le fichier .env est listé dans .gitignore et NE DOIT JAMAIS être
# commité sur GitHub.
# ==============================================================================

# Domaine & SSL (Caddy Reverse Proxy)
# Exemple : jobs.mondomaine.com ou 185.194.142.163.sslip.io ou :80
DOMAIN=localhost

# Environnement (development | production)
ENVIRONMENT=development
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
# Sécurité & JWT
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITATION_CODE=INVIT-CHANGE-ME

# Base de données MongoDB
DATABASE_NAME=job_tracker
MONGO_USER=mongo_user
MONGO_PASSWORD=change_this_password
MONGO_HOST=mongodb
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:27017/${DATABASE_NAME}?authSource=admin

# Base de données MongoDB (Tests)
MONGO_TEST_USER=test_user
MONGO_TEST_PASSWORD=test_password
MONGO_TEST_HOST=mongo_test
DATABASE_NAME_TEST=test-db

# Mongo Express (interface de gestion DB)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change_this_password

# Modèles IA (LLM)
SUMMARY_MODEL=gpt-5-nano
CRAWL_LLM_MODEL=openai/gpt-4o-mini
CREW_LLM_MODEL=gpt-5.6-luna
EVALUATION_MODEL=gemini/gemini-3.8-flash
EVALUATION_FALLBACK_MODEL=gemini/gemini-3.8-flash
CV_TAILOR_MODEL=gemini/gemini-3.8-flash
LETTER_MODEL_ANALYST=gemini/gemini-3.8-flash
LETTER_MODEL_WRITER=openai/gpt-5.6-terra
LETTER_MODEL_CRITIC=gemini/gemini-3.8-flash
LETTER_MODEL_REVISER=openai/gpt-5.6-terra
ROLE_SUGGESTION_MODEL=openai/gpt-4o-mini

# Clés d'API (Fournisseurs LLM & Outils)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=

# Source France Travail (Optionnel)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
