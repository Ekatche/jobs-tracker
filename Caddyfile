# Caddyfile pour Job Tracker sur VPS Netcup
# Gère automatiquement les certificats HTTPS Let's Encrypt et le reverse proxy hermétique.

{$DOMAIN:localhost} {
    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Compression moderne (Gzip + Zstandard)
    encode gzip zstd

    # Route /api/* vers backend:8000 en retirant automatiquement le préfixe /api
    # Point d'entrée standard de tous les appels API du frontend Next.js
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Compatibilité POST direct pour /auth/register
    @api_register {
        method POST
        path /auth/register
    }
    handle @api_register {
        reverse_proxy backend:8000
    }

    # Routes d'API et documentation directes du Backend FastAPI
    @api_direct {
        path /auth/token /auth/me /auth/refresh /auth/logout /auth/change-password
        path /docs* /openapi.json /redoc* /uploads/*
    }
    handle @api_direct {
        reverse_proxy backend:8000
    }

    # Toutes les pages web et assets vont au Frontend Next.js
    # (/auth/login, GET /auth/register, /resumes, /applications, /profile, /_next/*, etc.)
    handle {
        reverse_proxy frontend:3875
    }
}
